# Applies to every Vercel project built from this repo (backend AND frontend), so never list
# frontend/ or backend/app/ here: the frontend build needs frontend/, the backend needs backend/app/.
backend/tests/
backend/data/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
.github/
backend/scripts/
# Monorepo packages: their sources are needed (frontend build, backend imports), their tests and installs are not.
packages/*/node_modules/
products/*/web/node_modules/
products/*/web/dist/
products/*/api/tests/
products/*/api/data/
