# Safarnama API. Copy to .env (never commit it).

# Groq (free tier) powers planning, re-planning and the travel companion: https://console.groq.com/keys
GROQ_API_KEY=

# Shared Postgres (e.g. Neon). Unset → local SQLite in ./data. Trips live in the "tripweaver" schema.
DATABASE_URL=

# The deployed Safarnama web app (always allowed by CORS), plus any extra origins (comma-separated).
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5175
