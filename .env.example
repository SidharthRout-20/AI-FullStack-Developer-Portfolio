# Copy to `.env` (git-ignored) and fill in. Every setting has a safe default.

# ── LLM provider: "anthropic" (Claude, default) | "groq" (free tier) | "ollama" (local) ──
LLM_PROVIDER=groq

# Claude — create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium               # low | medium | high | xhigh | max (depth vs. latency/cost)

# Groq — free key at https://console.groq.com/keys (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # production disables /docs and enables HSTS
CORS_ORIGINS=http://localhost:5173 # comma-separated; add your deployed frontend URL (it calls the backend directly)
# FRAME_ANCESTORS='none'           # on Hugging Face Spaces: https://huggingface.co

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT=20/minute
# ADMIN_API_KEY=                   # enables POST /api/admin/reindex when set
                                   # generate: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# TOP_K=5
# RELEVANCE_THRESHOLD=0.50
# RELEVANCE_MARGIN=0.12

# ── Keeper (personal assistant) ──────────────────────────────────────────────
# GROQ_VISION_MODEL=qwen/qwen3.8-27b  # reads photos (labels, warranty cards, receipts)
# KEEPER_ACCESS_KEY=                 # set when Keeper is reachable from the internet; the UI asks once
# Daily brief on Telegram: create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# KEEPER_BRIEF_HOUR=8                # local hour to send the brief

# ── Product suite ────────────────────────────────────────────────────────────
# WHISPER_MODEL=whisper-large-v3-turbo  # MeetingMind transcription (Groq, free tier; uses GROQ_API_KEY)
# TripWeaver uses Open-Meteo, Photon/Nominatim and OpenStreetMap tiles: free, no keys needed.
