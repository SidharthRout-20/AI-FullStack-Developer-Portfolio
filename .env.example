# Copy to `.env` (git-ignored) and fill in. Every setting has a safe default.
# On Vercel, enter only the value (e.g. production): never paste a trailing # comment into the value field.

# ── LLM provider: "groq" (free tier, default) | "anthropic" (Claude) | "ollama" (local) ──
LLM_PROVIDER=groq

# Claude — create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (depth vs. latency/cost)
CLAUDE_EFFORT=medium

# Groq — free key at https://console.groq.com/keys (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── App ──────────────────────────────────────────────────────────────────────
# production disables /docs and enables HSTS
ENVIRONMENT=development
# comma-separated; add your deployed frontend URL (it calls the backend directly)
CORS_ORIGINS=http://localhost:5173
# The deployed frontend is always allowed as well (empty value turns that off)
# FRONTEND_URL=https://ai-full-stack-developer-portfolio-p.vercel.app
# on Hugging Face Spaces: https://huggingface.co
# FRAME_ANCESTORS='none'

# ── Storage ──────────────────────────────────────────────────────────────────
# Shared Postgres (e.g. Neon). REQUIRED on Vercel/serverless, where local files vanish between requests;
# the Vercel Neon integration sets it for you. Unset → one SQLite file per product in backend/data.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Scheduled jobs (reminders, daily brief, scheduled flows) ────────────────
# Serverless hosts run nothing between requests: point a free every-minute cron (e.g. cron-job.org) at
#   GET https://<backend>/api/cron/tick   with header   Authorization: Bearer <CRON_SECRET>
# Always-on hosts (Docker, local) run these jobs in the background without it.
# CRON_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT=20/minute
# enables POST /api/admin/reindex when set
# ADMIN_API_KEY=
                                   # generate: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# TOP_K=5
# RELEVANCE_THRESHOLD=0.50
# RELEVANCE_MARGIN=0.12

# ── Keeper (personal assistant) ──────────────────────────────────────────────
# reads photos (labels, warranty cards, receipts)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# set when Keeper is reachable from the internet; the UI asks once
# KEEPER_ACCESS_KEY=
# Reminders reach your phone through ntfy (free app, no account: set the topic in Keeper → Reminders)
# and/or Telegram. Telegram: create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# default hour for the morning brief (changeable in Keeper → Reminders)
# KEEPER_BRIEF_HOUR=8

# ── Product suite ────────────────────────────────────────────────────────────
# MeetingMind transcription (Groq, free tier; uses GROQ_API_KEY)
# WHISPER_MODEL=whisper-large-v3-turbo
# TripWeaver uses Open-Meteo (weather, UV, air quality), Photon/Nominatim, Overpass, OSRM routing and
# OpenStreetMap tiles: all free, no keys needed.
